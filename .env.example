# Database connection string
MONGODB_URI=mongodb://127.0.0.1/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional self-hosted Umami (runtime only; leave empty to disable analytics)
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Local upload directory (Coolify: /app/media with persistent storage)
PAYLOAD_UPLOAD_DIR=./media

# Set to staging for X-Robots-Tag: noindex and robots.txt blocking
APP_ENV=production

# Mail Server Configuration
# Set to json for local development without sending email; leave empty for SMTP.
EMAIL_TRANSPORT=
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=your-email-username
SMTP_PASS=your-email-password

# Gemini API
GEMINI_API_KEY=your-gemini-api-key
