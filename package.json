{
  "name": "the-easycode-mongodb",
  "version": "1.0.0",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build --webpack",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "dev:local": "pnpm local:db && pnpm dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "local:db": "node scripts/local-db.mjs start",
    "local:db:stop": "node scripts/local-db.mjs stop",
    "local:db:status": "node scripts/local-db.mjs status",
    "local:import": "node scripts/local-import.mjs",
    "local:refresh": "node scripts/local-refresh.mjs",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "evaluate:compiler": "vitest run --config ./experiments/compiler/vitest.config.mts",
    "dev:turbopack": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbopack",
    "build:turbopack": "cross-env NODE_OPTIONS=--no-deprecation next build --turbopack"
  },
  "dependencies": {
    "@fluejs/noscroll": "^1.0.0",
    "@payloadcms/admin-bar": "3.90.2",
    "@payloadcms/db-mongodb": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-form-builder": "3.90.2",
    "@payloadcms/plugin-nested-docs": "3.90.2",
    "@payloadcms/plugin-redirects": "3.90.2",
    "@payloadcms/plugin-search": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@splidejs/react-splide": "^0.7.12",
    "@splidejs/splide": "4.1.4",
    "@splidejs/splide-extension-auto-scroll": "^0.5.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "graphql": "^16.14.2",
    "lottie-react": "^3.1.2",
    "lucide-react": "^1.51.0",
    "next": "^16.3.8",
    "payload": "3.90.2",
    "prism-react-renderer": "^2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@next/playwright": "16.3.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "18.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "^10.23.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "dompurify@3.2.7": "3.4.16",
      "payload>undici": "7.30.0",
      "@payloadcms/email-nodemailer>nodemailer": "10.0.13"
    }
  },
  "packageManager": "pnpm@10.23.0"
}
