[Unit]
Description=Nightly verified Mailcow backup and single-generation rotation
After=docker.service
Requires=docker.service
RequiresMountsFor=/mnt/HC_Volume_102089935

[Service]
Type=oneshot
User=root
UMask=0077
WorkingDirectory=/srv/mailcow-nightly-backup
ExecStart=/usr/bin/python3 /srv/mailcow-nightly-backup/nightly.py run
Nice=10
CPUQuota=200%
MemoryMax=1G
TimeoutStartSec=6h
